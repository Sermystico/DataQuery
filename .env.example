# ==============================================================================
# DataQuery Environment Variables Template
# Copy this file to .env and configure local development values.
# NEVER commit .env to version control.
# ==============================================================================

# Database Configuration
POSTGRES_DB=dataquery_dev
POSTGRES_OWNER_USER=dq_owner
POSTGRES_OWNER_PASSWORD=dq_owner_dev_pw
POSTGRES_READONLY_USER=dq_readonly
POSTGRES_READONLY_PASSWORD=dq_readonly_dev_pw
POSTGRES_APP_USER=dq_app
POSTGRES_APP_PASSWORD=dq_app_dev_pw

# Network Ports & Host
# Use DB_HOST=localhost and DB_PORT=5434 for local host python runs.
# Docker Compose overrides DB_HOST=db and DB_PORT=5432 internally.
DB_HOST=localhost
DB_PORT=5434
FRONTEND_PORT=3000

# LLM Provider Configuration
# Supported options: mock | ollama | anthropic | gemini
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=mock-dev-key-not-active
LLM_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration (when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local LLM Configuration (when LLM_PROVIDER=ollama)
# Use http://localhost:11434 for local host runs, http://host.docker.internal:11434 for Docker
OLLAMA_BASE_URL=http://localhost:11434
# For Ollama, set LLM_MODEL to an installed chat model (e.g., llama3.2:latest).
# Note: nomic-embed-text is an embedding model and cannot be used for chat/SQL generation.
# LLM_MODEL=llama3.2:latest

# Analytics Context & Query Constraints
ANALYTICS_AS_OF_DATE=2024-11-01T00:00:00Z
QUERY_TIMEOUT_MS=3000
MAX_RESULT_ROWS=100

# API & Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost
